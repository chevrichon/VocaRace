{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['ownerUid', 'status', 'isPublic', 'listName', 'datasetType', 'vocab', 'createdAt', 'players'])",
        "ownerUid": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
        },
        "status": {
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing'"
        },
        "isPublic": {
          ".validate": "newData.isBoolean()"
        },
        "listName": {
          ".validate": "newData.isString()"
        },
        "datasetType": {
          ".validate": "newData.val() === 'vocab' || newData.val() === 'history'"
        },
        "vocab": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "players": {
          ".validate": "newData.hasChild('p1') && newData.child('p1').child('uid').val() === newData.parent().child('ownerUid').val()",
          "p1": {
            "uid": {
              ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
            }
          },
          "p2": {
            ".write": "auth != null && ((!data.exists() && root.child('rooms').child($roomId).child('status').val() === 'waiting' && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
            "uid": {
              ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
            }
          }
        }
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      "$scoreId": {
        ".write": "auth != null && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','name','score','timeMs','mode','dataset','list','createdAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "timeMs": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "mode": {
          ".validate": "newData.isString()"
        },
        "dataset": {
          ".validate": "newData.val() === 'vocab' || newData.val() === 'history'"
        },
        "list": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['pseudo'])",
        "pseudo": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "creatorEditors": {
      ".read": "auth != null && auth.token.email === 'udfba5682@accounts.vocarace.invalid'",
      "$uid": {
        ".read": "auth != null && (auth.token.email === 'udfba5682@accounts.vocarace.invalid' || auth.uid === $uid)",
        ".write": "auth != null && auth.token.email === 'udfba5682@accounts.vocarace.invalid'",
        ".validate": "newData.isBoolean()"
      }
    },
    "creatorLibrary": {
      ".read": "auth != null && (auth.token.email === 'udfba5682@accounts.vocarace.invalid' || root.child('creatorEditors').child(auth.uid).val() === true)",
      "$entryId": {
        ".write": "auth != null && (auth.token.email === 'udfba5682@accounts.vocarace.invalid' || (root.child('creatorEditors').child(auth.uid).val() === true && ((!data.exists() && newData.exists() && newData.child('savedBy').val() === auth.uid) || (data.exists() && data.child('savedBy').val() === auth.uid && (!newData.exists() || newData.child('savedBy').val() === auth.uid)))))",
        ".validate": "newData.hasChildren(['filename','extension','content','updatedAt','savedBy'])",
        "filename": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "extension": {
          ".validate": "newData.val() === '.histoire' || newData.val() === '.espagnol' || newData.val() === '.geo'"
        },
        "content": {
          ".validate": "newData.isString() && newData.val().length <= 7500000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "savedBy": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        }
      }
    }
  }
}
